function! LuaRun() abort
    write
    let l:file = expand('%:p')
    if has('terminal')
        execute 'split | terminal lua ' . fnameescape(l:file)
    else
        execute '!lua ' . fnameescape(l:file)
    endif
endfunction

command! LuaRun call LuaRun()
