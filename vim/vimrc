" ==============================================================================
" Portable Vim setup for C/C++ with Neovim-style navigation and tools
" ==============================================================================

" ------------------------------------------------------------------------------
" 1. Essential Initialization & Leader Key (MUST BE FIRST)
" ------------------------------------------------------------------------------
set nocompatible
filetype plugin indent on
syntax on

let mapleader = " "
let maplocalleader = " "

" Keep this config self-contained when moved to another machine.
let s:vim_config_dir = expand('<sfile>:p:h')
execute 'set runtimepath^=' . fnameescape(s:vim_config_dir)
execute 'set runtimepath+=' . fnameescape(s:vim_config_dir . '/after')

" ------------------------------------------------------------------------------
" 2. File picker (FZF when installed, built-in Vim otherwise)
" ------------------------------------------------------------------------------
" Plugin commands are defined after vimrc is read, so resolve these at keypress.
let g:fzf_layout = { 'window': { 'width': 0.92, 'height': 0.80 } }
function! s:FilePicker() abort
    if exists(':Files')
        Files
    else
        execute 'find ' . fnameescape(input('Find file: '))
    endif
endfunction

function! s:SearchProject() abort
    let l:query = input('Search: ')
    if empty(l:query)
        return
    endif
    if exists(':Rg')
        execute 'Rg ' . fnameescape(l:query)
    elseif executable('rg')
        execute 'silent! grep! ' . shellescape(l:query)
        copen
    else
        execute 'vimgrep /' . escape(l:query, '/') . '/ **/*'
        copen
    endif
endfunction

nnoremap <silent> <C-p> :call <SID>FilePicker()<CR>
nnoremap <silent> <leader>f :call <SID>FilePicker()<CR>
nnoremap <silent> <leader>ff :call <SID>FilePicker()<CR>
nnoremap <silent> <leader><Space> :call <SID>FilePicker()<CR>
nnoremap <silent> <leader>e :Explore<CR>
nnoremap <silent> <leader>/ :call <SID>SearchProject()<CR>
nnoremap <silent> <leader>fg :call <SID>SearchProject()<CR>

if executable('rg')
    set grepprg=rg\ --vimgrep\ --smart-case
    set grepformat=%f:%l:%c:%m
endif

set path+=**
set wildignore+=*.o,*.obj,*.bin,*.out,*.so,*.a,*.class
set wildignore+=*/.git/*,*/node_modules/*,*/build/*,*/dist/*,*/target/*

" ------------------------------------------------------------------------------
" 4. Colorscheme: local Matushell palette (with a portable fallback)
" ------------------------------------------------------------------------------
function! s:ApplyColorScheme() abort
    try
        colorscheme matushell
    catch
        set background=dark
    endtry
endfunction
augroup LocalColorScheme
    autocmd!
    autocmd VimEnter * call <SID>ApplyColorScheme()
augroup END

" ------------------------------------------------------------------------------
" 5. Line Numbering: Absolute Line Numbering
" ------------------------------------------------------------------------------
set number
set norelativenumber
set numberwidth=4
if has('patch-8.1.1564') || has('signs')
    set signcolumn=yes
endif

" Cursorline & Colors
set cursorline
set hidden
set mouse=a
if has('termguicolors')
    set termguicolors
endif

" Text wrapping & view context (matching Neovim options)
set nowrap
set linebreak
set breakindent
set scrolloff=4
set sidescrolloff=8

" Indentation (standard 4 spaces)
set tabstop=4
set softtabstop=4
set shiftwidth=4
set expandtab
set shiftround
set autoindent
set smartindent

" Splits behavior
set splitbelow
set splitright

" Search behavior
set ignorecase
set smartcase
set incsearch
set nohlsearch

" Clipboard sync with system (unnamedplus)
if has('clipboard')
    set clipboard=unnamedplus
endif

" Undo & history persistence (swap/backup disabled like Neovim)
set noswapfile
set nobackup
set nowritebackup
set history=10000
set undolevels=10000
if has('persistent_undo')
    let s:undo_dir = expand('~/.vim/undo')
    if !isdirectory(s:undo_dir)
        call mkdir(s:undo_dir, 'p')
    endif
    set undofile
    let &undodir = s:undo_dir
endif

" Completion wildmenu
set wildmenu
set wildmode=longest:full,full
if has('patch-8.2.4325') || v:version >= 900
    set wildoptions=pum
endif
set pumheight=10

" C/C++ files use four-space indentation regardless of the host's defaults.
augroup CppSettings
    autocmd!
    autocmd FileType c,cpp setlocal tabstop=4 softtabstop=4 shiftwidth=4 expandtab
    autocmd FileType c,cpp setlocal commentstring=//\ %s
    autocmd FileType c,cpp setlocal path+=include/**,src/**
augroup END

" clangd provides C++ completion/navigation through vim-lsp when available.
if executable('clangd')
    augroup ClangdLsp
        autocmd!
        autocmd User lsp_setup call lsp#register_server({
            \ 'name': 'clangd',
            \ 'cmd': {server_info -> ['clangd', '--background-index']},
            \ 'allowlist': ['c', 'cpp', 'objc', 'objcpp']
            \ })
    augroup END
    inoremap <silent> <C-Space> <C-x><C-o>
endif
function! s:SetupCppCompletion() abort
    if exists(':LspDefinition') && executable('clangd')
        setlocal omnifunc=lsp#complete
    endif
endfunction
autocmd CppSettings FileType c,cpp call s:SetupCppCompletion()

function! s:BufferPicker() abort
